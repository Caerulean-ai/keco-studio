#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# 获取当前分支名
current_branch=$(git symbolic-ref --short HEAD 2>/dev/null)

# 对所有分支的 push 都进行构建检查
# 这样可以确保每个 PR 在创建前都通过了构建检查
echo "🚀 正在运行构建检查（分支: $current_branch）..."
echo ""

# 运行构建检查
echo "🔨 运行构建检查..."
npm run build || {
  echo "❌ 构建失败，请修复错误后再推送"
  echo "💡 提示：可以在本地运行 'npm run build' 查看详细错误信息"
  exit 1
}

echo "✅ 构建检查通过，可以安全推送"

